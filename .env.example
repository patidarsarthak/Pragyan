# ==============================================================================
# SIH26074 - Environment Variables Configuration (.env.example)
# Open-Source MapLibre GIS Stack & Government of India Administrative Hierarchy
# ==============================================================================

# 1. Base Map Vector & Raster Style Provider (OSM / Permitted Vector Tiles)
MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
OSM_RASTER_TILES=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# 2. Permitted Free/Open Satellite Imagery Provider
# (Sub-meter aerial reference; e.g. Esri World Imagery / USGS / Open Aerial Map)
SATELLITE_STYLE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}

# 3. Contextual Vector Tile Provider (OSM-derived roads, waterways, landuse, POIs)
VECTOR_TILE_URL=https://demotiles.maplibre.org/tiles/{z}/{x}/{y}.pbf
LABELS_TILE_URL=https://a.basemaps.cartocdn.com/rastertiles/voyager_only_labels/{z}/{x}/{y}.png

# 4. Geocoding / Search Provider (OpenStreetMap Nominatim or internal GIS search)
GEOCODING_URL=https://nominatim.openstreetmap.org/search

# 5. Authoritative Provider Attributions
MAP_ATTRIBUTION=Satellite: Esri, Maxar, Earthstar Geographics | Geographic Context: © OpenStreetMap contributors, MapLibre | Administrative Hierarchy: Ministry of Panchayati Raj / LGD, Survey of India, Bharat Maps

# 6. Database Connection (SQLite local fallback / PostgreSQL + PostGIS production)
# Development SQLite:
DATABASE_URL=sqlite:///backend/sih26074_panchayat.db
# Production PostgreSQL + PostGIS:
# DATABASE_URL=postgresql://sih_user:secure_password@localhost:5432/sih26074_spatial

# 7. Server Settings
PORT=8000
HOST=127.0.0.1
DEBUG=True
CORS_ORIGINS=["*"]

# 8. Optional Integrations (100% Optional — Graceful Offline Fallbacks Active If Unset)
# Live Cellular SMS & Farmer Voice Dispatch (Twilio API):
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_NUMBER=+1234567890

# Multi-lingual Advisory Polish (Hindi / Malwi linguistic translation):
# (Deterministic agronomic rule-engine is used by default with zero hallucination)
# GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxx
